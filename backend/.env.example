# Puerto del servidor
PORT=5001

# URL del frontend
FRONTEND_URL=http://localhost:3000

# Entorno (development | production)
NODE_ENV=development

# MongoDB - URI de conexión
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster.mongodb.net/meapunto?retryWrites=true&w=majority

# JWT - Secret para firmar tokens (genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=GENERA_UNA_CLAVE_ALEATORIA_LARGA_AQUI

# Resend - API key para enviar correos (obténla en resend.com)
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXX

# Stripe - Secret key (obténla en stripe.com/dashboard)
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXX

# Cloudinary - Credenciales (obténlas en cloudinary.com)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
